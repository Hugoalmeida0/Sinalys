# Copie para backend/.env e preencha. Nunca versione o .env.

# Supabase — Project Settings > API no painel do Supabase
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# UUID do projeto usado quando o usuário não tem app_metadata.projeto_id
DEFAULT_PROJETO_ID=
SUPABASE_STORAGE_BUCKET_INGESTAO=ingestao-raw

# OpenRouter (LLM do diagnóstico e do chat) — openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODELO_LLM=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODELO_CHAT=nvidia/nemotron-3-super-120b-a12b:free

# Gemini (embeddings) — Google AI Studio > API Keys
GEMINI_API_KEY=
GEMINI_MODELO_EMBEDDING=gemini-embedding-001

# URL do frontend (CORS e cabeçalho HTTP-Referer da OpenRouter)
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# true quando a API estiver atrás de HTTPS
COOKIE_SECURE=false
